# Copy to /etc/trend-exploring/trend-exploring.env and edit locally.
# chmod 600 /etc/trend-exploring/trend-exploring.env; never commit the copy.

APP_ENV=production
APP_BIND=127.0.0.1
APP_PORT=3000
PORT=3000
BIND_ADDRESS=127.0.0.1
PUBLIC_ORIGIN=https://zixin.space
AUTH_MODE=required
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
CLOUD_RELEASE_ROOT=/opt/trend-exploring/current
CLOUD_STATE_DIR=/var/lib/trend-exploring
CLOUD_LOCK_ROOT=/var/lib/trend-exploring/locks
CLOUD_ENV_FILE=/etc/trend-exploring/trend-exploring.env
LOCAL_STATE_DIR=/var/lib/trend-exploring

# Cloud auth agent contract: this must be explicit in production. Any local
# development or anonymous deployment flag is rejected by runtime preflight.
CLOUD_PUBLIC_DEPLOYMENT=1

# Authentication is mandatory for /app, all data APIs, and paid actions.
# A value of 1 is rejected by every cloud worker and must never be deployed.
PUBLIC_UNAUTHENTICATED_MODE=0
AUTH_REQUIRED_FOR_APP=1
PUBLISH_API_ENABLED=0

# Provision locally/over SSH with scripts/local/configure_cloud_owner.rb; do
# not put the actual values in Git or command-line arguments.
CLOUD_IDENTITY_PEPPER=
CLOUD_SESSION_PEPPER=

# Prefer a PostgreSQL Unix socket; this URL is not a secret.
DATABASE_URL=postgresql:///trend_exploring?host=/var/run/postgresql
M1_DATABASE_URL=
PERSONAL_DATABASE_URL=postgresql:///trend_exploring_personal?host=/var/run/postgresql
LOCAL_PGSOCKET=/var/run/postgresql
LOCAL_PGPORT=5432
LOCAL_PGUSER=trendexploring
LOCAL_PGDATABASE=trend_exploring
PERSONAL_PGDATABASE=trend_exploring_personal
PG_BIN=/usr/bin
CLOUD_PG_ROLE=trendexploring
CLOUD_PG_GLOBAL_DATABASE=trend_exploring
CLOUD_PG_PERSONAL_DATABASE=trend_exploring_personal

# Exact runtime dependency checked by preflight. Keep this in sync with the
# integration Gemfile.lock when the application dependency set is wired in.
CLOUD_WEBRICK_VERSION=1.8.1

# Optional command hooks. Commands run as the dedicated service account and
# must not put credentials in argv. Leave empty to use wrapper defaults.
CLOUD_SERVER_COMMAND=
CLOUD_COLLECT_COMMAND=
CLOUD_CYCLE_COMMAND=
CLOUD_TRANSLATION_COMMAND=
CLOUD_MIGRATION_COMMAND=
CLOUD_STALE_RECOVERY_COMMAND=

# Backup policy is deliberately bounded to 7-14 local snapshots.
CLOUD_BACKUP_ROOT=/var/backups/trend-exploring
CLOUD_BACKUP_RETENTION=10
# Set to an operator-managed public GPG recipient; no private key belongs here.
CLOUD_BACKUP_GPG_RECIPIENT=
CLOUD_BACKUP_VERIFY_HOOK=
CLOUD_BACKUP_RESTORE_HOOK=
CLOUD_BACKUP_OFFSITE_HOOK=

# Caddy obtains certificates for this host; email is optional but recommended.
CADDY_DOMAIN=zixin.space
CADDY_EMAIL=
