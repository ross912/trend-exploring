{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trend-exploring.local/schema/m2-readiness-artifact.v1.json",
  "title": "M2 readiness evidence artifact",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "testCode", "command", "result", "verified", "verifiedAt", "runtime", "testPaths", "stdoutPath", "stdoutSha256", "commandExitStatus", "runner"],
  "properties": {
    "schemaVersion": { "const": "m2.readiness-artifact.v1" },
    "testCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}[A-Z]?$" },
    "command": { "type": "string", "minLength": 1 },
    "result": { "enum": ["not_run", "passed", "failed", "environment_blocked", "external_blocked"] },
    "verified": { "const": true },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "runtime": { "type": ["object", "null"] },
    "testPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "stdoutPath": { "type": "string", "minLength": 1 },
    "stdoutSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commandExitStatus": { "type": ["integer", "null"] },
    "runner": { "const": "scripts/record_m1_readiness_evidence.rb" }
  }
}
